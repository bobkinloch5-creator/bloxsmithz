# Server-only AI gateways. Never commit real keys.
# Comet's docs call this COMETAPI_KEY. COMET_API_KEY is kept as a backwards-compatible alias.
COMETAPI_KEY=
COMET_API_KEY=
COMET_BASE_URL=https://api.cometapi.com/v1
COMET_VIDEO_TASKS_URL=https://api.cometapi.com/v1/videos
COMET_VIDEO_MODEL=sora-2-pro
NEOKENS_API_KEY=
NEOKENS_KEY=
NEOKENS_BASE_URL=https://api.quatarly.cloud/v1

# Anthropic-compatible aliases for the Quatarly/Neokens gateway.
# Useful for Claude Code style environments; leave real keys in .env.local or host env only.
ANTHROPIC_BASE_URL=https://api.quatarly.cloud/
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6-thinking
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7-thinking
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
GROQ_API_KEY=

# Shared-key protection for normal users.
AI_DAILY_REQUEST_LIMIT=8
AI_DAILY_WINDOW_HOURS=24
AI_CLAUDE_OPUS_48_DAILY_LIMIT=1
AI_CLAUDE_OPUS_DAILY_LIMIT=1
AI_PREMIUM_MODEL_DAILY_LIMIT=1
GEMINI_IMAGE_HOURLY_LIMIT=2
